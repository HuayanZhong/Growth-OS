{
  "extends": "../../tooling/typescript/framework/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "mikro-orm.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}