                    },
                    "details": {
                      "description": "结构化补充信息（如 VALIDATION_ERROR 的字段级 issue 列表）"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "获取当前登录用户（JWT 保护）",
        "tags": [
          "auth"
        ]
