                          },
                          "action": {
                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string"
                          },
                          "resourceId": {
                            "type": "string"
                          },
                          "timestamp": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "details": {}
                        },
                        "required": [
                          "id",
                          "actorId",
                          "action",
                          "resourceType",
                          "resourceId",
                          "timestamp"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求参数校验失败（VALIDATION_ERROR，details 含字段级 issue）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "机器可读错误码（SCREAMING_SNAKE_CASE，如 NOT_FOUND / VALIDATION_ERROR）"
