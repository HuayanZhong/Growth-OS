{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "description": "Growth OS 后端服务 - NestJS",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run",
    "test:e2e": "dotenv -e ../../.env -e ../../.env.development -- vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint --fix --config .oxlintrc.json",
    "format": "oxfmt --config ../../tooling/format/.oxfmtrc.json",
    "typecheck": "tsc --noEmit",
    "mikro-orm:debug": "dotenv -e ../../.env -e ../../.env.development -- mikro-orm debug",
    "mikro-orm:migration:create": "dotenv -e ../../.env -e ../../.env.development -- mikro-orm migration:create",
    "mikro-orm:migration:up": "dotenv -e ../../.env -e ../../.env.development -- mikro-orm migration:up",
    "mikro-orm:migration:down": "dotenv -e ../../.env -e ../../.env.development -- mikro-orm migration:down",
    "mikro-orm:seeder:run": "dotenv -e ../../.env -e ../../.env.development -- mikro-orm seeder:run"
  },
  "dependencies": {
    "@growth-os/shared": "workspace:*",
    "@growth-os/types": "workspace:*",
    "@mikro-orm/cli": "catalog:backend",
    "@mikro-orm/core": "catalog:backend",
    "@mikro-orm/decorators": "catalog:backend",
    "@mikro-orm/migrations": "catalog:backend",
    "@mikro-orm/nestjs": "catalog:backend",
    "@mikro-orm/postgresql": "catalog:backend",
    "@mikro-orm/reflection": "catalog:backend",
    "@nestjs/common": "catalog:backend",
    "@nestjs/config": "catalog:backend",
    "@nestjs/core": "catalog:backend",
    "@nestjs/platform-express": "catalog:backend",
    "jose": "catalog:backend",
    "nestjs-pino": "catalog:backend",
    "pino": "catalog:backend",
    "@nestjs/throttler": "catalog:backend",
    "compression": "catalog:backend",
    "helmet": "catalog:backend",
    "@nestjs/swagger": "catalog:backend",
    "reflect-metadata": "catalog:backend",
    "rxjs": "catalog:backend",
    "tsx": "catalog:backend",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:backend",
    "@nestjs/schematics": "catalog:backend",
    "@nestjs/testing": "catalog:backend",
    "@supabase/supabase-js": "catalog:frontend",
    "@types/compression": "catalog:backend",
    "@types/express": "catalog:backend",
    "@types/jest": "catalog:test",
    "@types/node": "catalog:dev",
    "@types/pg": "catalog:dev",
    "@types/supertest": "catalog:test",
    "@mikro-orm/seeder": "catalog:backend",
    "dotenv-cli": "catalog:dev",
    "jest": "catalog:test",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "pino-pretty": "catalog:dev",
    "supertest": "catalog:test",
    "ts-jest": "catalog:test",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^(\\.{1,2}/.*)\\.ts$": "$1"
    },
    "testEnvironment": "node"
  }
}
