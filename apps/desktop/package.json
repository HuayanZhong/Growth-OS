{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Growth OS 桌面端",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv ../../.env",
    "build": "nuxt build --dotenv ../../.env",
    "start:prod": "electron ../../packages/desktop-core/dist/main.js --no-sandbox",
    "lint": "oxlint --fix --config .oxlintrc.json",
    "format": "oxfmt --config ../../tooling/format/.oxfmtrc.json",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "verify:build": "electron scripts/verify-build.cjs"
  },
  "dependencies": {
    "@growth-os/desktop-core": "workspace:*",
    "@growth-os/shared": "workspace:*",
    "@growth-os/types": "workspace:*",
    "@growth-os/ui": "workspace:*",
    "@supabase/supabase-js": "catalog:frontend",
    "@tailwindcss/vite": "catalog:frontend",
    "daisyui": "catalog:frontend",
    "gsap": "catalog:frontend",
    "nuxt": "catalog:frontend",
    "tailwindcss": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:frontend",
    "@nuxt/test-utils": "catalog:test",
    "@vue/test-utils": "catalog:test",
    "electron": "catalog:frontend",
    "happy-dom": "catalog:test",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "oxlint-tailwindcss": "catalog:lint",
    "vite-plugin-electron": "catalog:frontend",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:frontend"
  }
}
