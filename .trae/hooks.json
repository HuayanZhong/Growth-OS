{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-guard-harness.cjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "loop_limit": 3,
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-user-profile-reminder.cjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
