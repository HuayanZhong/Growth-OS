{
  "name": "Growth OS",
  "version": "1.0.0",
  "description": "仿coze平台",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "dotenv -c development -- turbo run dev",
    "start": "dotenv -c production -- turbo run start:prod",
    "build": "dotenv -c production -- turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format --concurrency=1",
    "typecheck": "dotenv -v CI=true -- turbo run typecheck",
    "test": "dotenv -v CI=true -- turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0"
}
