{
  "name": "Growth OS",
  "version": "1.0.0",
  "description": "仿coze平台",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -e .env.development -e .env -- turbo run dev",
    "start": "dotenv -e .env.local -e .env.production -e .env -- turbo run start:prod",
    "build": "dotenv -e .env.local -e .env.production -e .env -- turbo run build",
    "lint": "turbo run lint",
    "hygiene": "knip && turbo run publint",
    "format": "turbo run format --concurrency=1",
    "typecheck": "dotenv -v CI=true -- turbo run typecheck",
    "test": "dotenv -v CI=true -- turbo run test",
    "test:coverage": "dotenv -v CI=true -- turbo run test:coverage",
    "verify:docs": "node scripts/verify-docs.cjs",
    "verify:pairing": "node scripts/verify-translation-pairing.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "husky": "catalog:dev",
    "knip": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "publint": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.1.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.1.0"
}
