  "cards": [
    {
      "dot": "cyan",
      "title": "摄取流水线",
      "items": [
        "五段主流水线：上传 → 接收 → 解析 → 切片 → 批量向量化；实体抽取从切片并行消费",
        "embedding 与实体抽取统一经 model-provider 出网；向量入 pgvector、实体关系入实体图、trust 与摄取状态登记进知识元数据"
      ]
    },
    {
      "dot": "emerald",
      "title": "隔离与衔接",
      "items": [
        "全程 user_id 隔离（RLS）；文档级 trust 等级供检索时过滤低信来源；摄取完成后由 RAG 检索域消费（检索内部机制见后续详图）"
      ]
    }
  ]
