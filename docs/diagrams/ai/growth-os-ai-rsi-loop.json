  "cards": [
    {
      "dot": "cyan",
      "title": "闭环五阶段",
      "items": [
        "采集：运行时 traces、用户反馈与执行结果统一汇入经验池",
        "分析：curriculum 子代理提取成功模式与失败归因，产出候选经验",
        "校验固化：verifier 子代理重放验证，evals 门槛未过不入库，高影响经验经人审后写入 OKF",
        "注入生效：retrieve_knowledge 检索固化经验注入运行时，新 traces 重新进入采集"
      ]
    },
    {
      "dot": "emerald",
      "title": "边界与约束",
      "items": [
        "全程 user_id 隔离，RLS 贯穿经验池与 OKF；只做系统级自改进（经验 / 策略 / 提示），不触碰模型权重——权重级训练属模型阶段能力，超出本系统边界"
      ]
    }
  ]
