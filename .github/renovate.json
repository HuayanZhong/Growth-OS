{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticPrefixChore", ":dependencyDashboard"],
  "timezone": "Asia/Shanghai",
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "groupName": "frontend",
      "matchPackagePatterns": [
        "^vue$",
        "^vue-router$",
        "^vue-tsc$",
        "^nuxt$",
        "^@nuxt/",
        "^@vue/",
        "^tailwindcss$",
        "^@tailwindcss/",
        "^daisyui$",
        "^tailwind-merge$",
        "^gsap$",
        "^clsx$",
        "^@supabase/"
      ]
    },
    {
      "groupName": "electron",
      "matchPackagePatterns": ["^electron", "^vite-plugin-electron$"]
    },
    {
      "groupName": "testing",
      "matchPackagePatterns": [
        "^vitest$",
        "^@vue/test-utils$",
        "^@nuxt/test-utils$",
        "^happy-dom$",
        "^supertest$",
        "^@swc/core$",
        "^unplugin-swc$"
      ]
    },
    {
      "groupName": "backend",
      "matchPackagePatterns": [
        "^@nestjs/",
        "^class-validator$",
        "^class-transformer$",
        "^reflect-metadata$",
        "^rxjs$",
        "^jose$",
        "^nestjs-pino$",
        "^pino",
        "^compression$",
        "^helmet$"
      ]
    },
    {
      "groupName": "tooling",
      "matchPackagePatterns": [
        "^turbo$",
        "^oxlint",
        "^oxfmt$",
        "^@types/",
        "^typescript$",
        "^tsx$",
        "^dotenv-cli$",
        "^husky$",
        "^lint-staged$",
        "^@commitlint/"
      ]
    },
    {
      "groupName": "shared",
      "matchPackagePatterns": ["^zod$"]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "TS 7 对 Nuxt 生态兼容性未就绪，适配后放宽"
    },
    {
      "matchPackagePatterns": ["^@mikro-orm/"],
      "enabled": false,
      "description": "精确钉 7.1.11（7.1.14 连接层有问题）；浮回复验通过后再启用"
    }
  ]
}
