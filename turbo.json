{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NUXT_PUBLIC_SITE_URL",
    "NUXT_PUBLIC_APP_NAME",
    "PORT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:prod": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {
      "dependsOn": [],
      "cache": false
    },
    "format": {
      "dependsOn": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [],
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "cache": false
    }
  }
}
