{
  "name": "@growth-os/desktop-core",
  "version": "1.0.0",
  "private": true,
  "description": "桌面端核心模块——Electron 主进程和 preload 源码",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "oxlint --fix --config .oxlintrc.json",
    "format": "oxfmt --config ../../tooling/format/.oxfmtrc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@growth-os/types": "workspace:*",
    "electron-updater": "catalog:frontend"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:test",
    "electron": "catalog:frontend",
    "electron-builder": "catalog:frontend",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "publint": "catalog:dev",
    "vitest": "catalog:test"
  }
}
