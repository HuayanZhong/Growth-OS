{
  "name": "@growth-os/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Growth OS UI 组件库 - 基于 daisyUI 整合封装，架构参考 shadcn（组件目录 / cn 工具 / barrel 导出）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main.css": "./src/styles/main.css"
  },
  "scripts": {
    "lint": "oxlint --fix --config .oxlintrc.json",
    "format": "oxfmt --config ../../tooling/format/.oxfmtrc.json",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "clsx": "catalog:frontend",
    "daisyui": "catalog:frontend",
    "tailwind-merge": "catalog:frontend",
    "tailwindcss": "catalog:frontend"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "@vue/test-utils": "catalog:test",
    "happy-dom": "catalog:test",
    "oxfmt": "catalog:format",
    "oxlint": "catalog:lint",
    "publint": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:frontend"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
