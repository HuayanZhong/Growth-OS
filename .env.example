# ============================================================
# Growth OS 环境变量模板
# ============================================================
#
# 加载机制（dotenv-cli 级联模式，由根 package.json 注入）：
#   pnpm dev    →  dotenv -c development  →  .env → .env.development
#   pnpm start  →  dotenv -c production   →  .env → .env.production
#   pnpm build  →  dotenv -c production   →  .env → .env.production
#
# 启动前请复制为三个文件并填值：
#   cp .env.example .env              # 共享默认（dev/prod 都会用到的值）
#   cp .env.example .env.development  # dev 覆盖（本地开发值）
#   cp .env.example .env.production   # prod 占位（买服务器后改成线上值）
#
# 级联规则：.env.{env} 中的变量会覆盖 .env 中的同名变量
#
# ============================================================
# 客户端可访问（构建时内联到前端 bundle，会暴露给终端用户）
# ============================================================
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=Growth OS
# Supabase 项目配置（publishable/anon key 非 secret，可暴露给前端）
# 从 Dashboard > Project Settings > API 获取
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# 自有后端 API 地址（桌面端 useApi 请求基座）
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ============================================================
# Nuxt 构建配置
# ============================================================
# Electron 用 loadFile 加载 index.html，必须用相对路径，否则白屏
NUXT_APP_BASE_URL=./

# ============================================================
# 后端服务配置
# ============================================================
# dev/prod 通常不同（避免端口冲突）
PORT=4000
# MikroORM 数据库连接（Supabase Postgres direct connection，db.<ref>.supabase.co:5432）
# 长期运行的后端进程用 direct；IPv4-only 网络用 session pooler（aws-<region>.pooler.supabase.com:5432）
# 不要用 transaction pooler（:6543）：MikroORM 的 prepared statements 会失效
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
# MikroORM 调试日志开关：true 时打印 SQL 查询与参数（生产环境保持 false）
DB_DEBUG=false
# Supabase 项目 URL（服务端 JWT 验证用）：可选，缺省回退 NUXT_PUBLIC_SUPABASE_URL
# SUPABASE_URL=
# Supabase anon key（HS256 legacy 项目验签用）：HS256 回退路径需要此值调 Auth 服务器探针
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
# 生产 CORS 白名单（逗号分隔 origin）：缺省全开；桌面端 file:// 无 Origin 头不受影响
# CORS_ORIGINS=
# 限流配置（可选）：TTL（毫秒）和窗口内最大请求数；缺省 60s / 100 次
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# PostgreSQL statement_timeout（可选）：单条查询最大执行时间（毫秒）；缺省 10s；设 0 可禁用（开发调试用）
# DB_STATEMENT_TIMEOUT_MS=10000

# ============================================================
# 桌面端打包配置（仅 pnpm build 时读取，dev 不读取）
# ============================================================
# 代码签名证书路径，electron-builder 自动读取
# 当前为自签名测试证书；正式分发前需替换为 OV/EV 证书
CSC_LINK=scripts/certs/growth-os-test.pfx
# 证书密码，对应 generate-test-cert.ps1 生成时设置的值
CSC_KEY_PASSWORD=
# 发布安装包到 GitHub Releases 所需的 Personal Access Token（需 repo 权限）
# 生成入口：https://github.com/settings/tokens
GH_TOKEN=
