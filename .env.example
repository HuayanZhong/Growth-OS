# ============================================================
# Growth OS 环境变量模板
# ============================================================
#
# 加载机制（dotenv-cli 级联模式）：
#   pnpm dev:server   →  dotenv -c development  →  .env → .env.development
#   pnpm start:server →  dotenv -c production   →  .env → .env.production
#   pnpm dev:desktop  →  dotenv -c development  →  .env → .env.development
#
# 启动前请复制为三个文件并填值：
#   cp .env.example .env              # 共享默认（dev/prod 都会用到的值）
#   cp .env.example .env.development  # dev 覆盖（本地开发值）
#   cp .env.example .env.production   # prod 占位（买服务器后改成线上值）
#
# 级联规则：.env.{env} 中的变量会覆盖 .env 中的同名变量
#
# ============================================================
# 客户端可访问（构建时内联到前端 bundle，会暴露给终端用户）
# ============================================================
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=Growth OS

# ============================================================
# Nuxt 构建配置
# ============================================================
# Electron 用 loadFile 加载 index.html，必须用相对路径，否则白屏
NUXT_APP_BASE_URL=./

# ============================================================
# 后端服务配置
# ============================================================
# dev/prod 通常不同（避免端口冲突）
PORT=4000
